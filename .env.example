# Example settings for the payment project. Copy this file to .env on your own machine.
# .env is never committed. Every value here is a safe, obviously fake local example:
# no real credentials, banking details or provider keys ever go in this file.

# TODO(M1): add PAYMENTS_PORT and PAYMENTS_LOG_LEVEL with safe example values
#           (one NAME=value line each), then delete this TODO comment.

# Local PostgreSQL for M5 (same PG* variables psql uses). Prefer ~/.pgpass for the password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=payments_dev
PGUSER=payments_dev
PGPASSWORD=change-me-local-only

# M5: document PAYMENTS_STORE=memory|jdbc here.
