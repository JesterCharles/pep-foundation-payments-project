# Example settings for Project 2. Copy this file to .env on your own machine; .env is never committed.
# Every value here is a safe, obviously fake local example: no real credentials, banking details or
# provider keys ever go in this file. All data in this project is synthetic.

# --- Supplied Javalin baseline (api/, payments.App) ---
PAYMENTS_PORT=7070
# memory (default) or jdbc. jdbc uses PAYMENTS_JDBC_URL or a local H2 file under api/data/.
PAYMENTS_STORE=memory
PAYMENTS_POLICY=standard

# --- Spring Boot API (api/, payments.PaymentsApplication) ---
SERVER_PORT=8080
# Mock payment provider used from week 8 (Fast) / week 9 (Standard); see docs/contracts/.
PROVIDER_BASE_URL=http://localhost:8089
# Local signing secret for development tokens only (32+ characters). Never reuse a real secret.
SECURITY_JWT_SECRET=local-dev-only-secret-change-me-0123456789

# --- PostgreSQL for Compose and the pipeline (same PG* variables psql uses) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=payments_dev
PGUSER=payments_dev
PGPASSWORD=change-me-local-only

# --- Pipeline service (pipeline/, payments_pipeline) ---
# Optional: one URL instead of the PG* values above.
PIPELINE_DATABASE_URL=
SPRING_API_BASE_URL=http://localhost:8080
# A token you obtained from POST /auth/login on your local API; never commit a real one.
SPRING_API_TOKEN=
SPRING_API_TIMEOUT_SECONDS=2
STATEMENTS_DIR=data/samples
# Stub AI categorisation provider (synthetic; no real AI service is called).
AI_PROVIDER_BASE_URL=http://localhost:8090
AI_PROVIDER_TIMEOUT_SECONDS=2

# --- Browser clients (web/, ui/): where the Vite dev proxy forwards API calls ---
API_BASE_URL=http://localhost:8080
